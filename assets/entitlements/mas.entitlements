<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    LocalPDF — Mac App Store entitlements.

    Privacy-first PDF tool: works fully offline, so no network capability is
    granted. File access is scoped to what the user explicitly picks via the
    file dialog or drags onto the app.

    Library validation is disabled because PyInstaller bundles signed Qt /
    Python dylibs from upstream that aren't signed with our identity. The
    Hardened Runtime still applies; we just don't require all nested code
    to chain to the same Team ID.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Allow open/save through standard file dialogs and drag-and-drop. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Common convenience: write outputs straight to ~/Downloads without re-prompting. -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Read scoped bookmarks the user has previously authorized (output folder). -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- PyInstaller bundles 3rd-party dylibs not signed with our identity. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
